# .aliases

alias rm='rm -I' # safety first
alias dcom='docker compose'
alias dk='docker'
alias ls='eza --group-directories-first'
alias la='ls -a'
alias lsa='ls -la'
alias ll='ls --git -l'
alias lt='ls --tree -D -L 2 -I ${TREE_IGNORE}'
alias ltt='ls --tree -D -L 3 -I ${TREE_IGNORE}'
alias lttt='ls --tree -D -L 4 -I ${TREE_IGNORE}'
alias ltttt='ls --tree -D -L 5 -I ${TREE_IGNORE}'
alias python="python3"

# AWS

alias aws-legacy='aws-vault exec aws.legacy --'
alias aws-stg='aws-vault exec aws.staging.warroom --'
alias aws-prod='aws-vault exec aws.warroom --'
alias aws-ssm-stg='~/.aws/ssm-stg.sh'

# Warroom deployment

alias deploy-stg='OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES aws-vault exec aws.staging.warroom -- ansible-playbook --private-key=~/.ssh/warroom-sg.pem -i'
alias deploy-prod='OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES aws-vault exec aws.warroom -- ansible-playbook --private-key=~/.ssh/warroom-sg.pem -i'
alias deploy-stg-wr-cbc=' deploy-stg hosts-staging/api-and-cbc.ini warroom-staging/web.yml'
alias deploy-stg-wr-external=' deploy-stg hosts-staging/external.ini warroom-staging/external.yml'
alias deploy-prod-wr-cbc=' deploy-prod hosts/web.ini ./warroom-production/web.yml'
alias deploy-prod-wr-external=' deploy-prod hosts/external.ini ./warroom-production/external.yml'